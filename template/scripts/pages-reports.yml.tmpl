# Deploys the orphan `gh-pages` branch (agent-published HTML reports) to
# GitHub Pages. The `publish-report` skill commits report folders plus a
# regenerated index, then fires a `repository_dispatch` of type
# `pages-reports` — dispatches run this default-branch copy of the
# workflow, since a bare `gh-pages` branch carries no workflow file of
# its own. The `push: branches: [gh-pages]` trigger stays for checkouts
# that do track the workflow file on that branch.
# Requires Pages enabled with source "GitHub Actions" (one-time repo setting).
name: Deploy reports to Pages

on:
  push:
    branches: [gh-pages]
  repository_dispatch:
    types: [pages-reports]

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout gh-pages
        uses: actions/checkout@v4
        with:
          ref: gh-pages
      - name: Setup Pages
        uses: actions/configure-pages@v5
      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: .

  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
