# Copy to .sandcastle/.env and fill. Never commit .env.
# Sandcastle resolves secrets from .sandcastle/.env only (ignores repo root .env).

# GitHub — required for `gh issue view` inside sandbox
GH_TOKEN=

# Agent model — required. Known-good default: opencode/big-pickle
OPENCODE_MODEL={{MODEL_ID}}

# Credential for your OPENCODE_MODEL — required (one of below; see VERIFY-TODO).
# Default slot rendered by bootstrap:
{{CREDENTIAL_VAR}}=
# VERIFY-TODO(model-auth): confirm the credential for this model on the host
# (`opencode providers login` or the env var above) for headless runs.

# Documented examples for other models (leave commented unless you use them):
# For opencode / Claude Code OAuth (run `claude setup-token` on host if using Claude)
#CLAUDE_CODE_OAUTH_TOKEN=
# Or Anthropic API key alternative
#ANTHROPIC_API_KEY=
